# Copie este arquivo para .env (Copy-Item .env.example .env) e preencha a chave.
# O arquivo .env está no .gitignore: a chave real nunca deve ir para o Git.

# Chave da API da OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sua_chave_aqui

# Modelo usado na extração e na explicação
OPENAI_MODEL=gpt-4.1-mini

# Endereço do endpoint de predição usado pelo notebook do assistente
# (o endpoint POST /explicar da API não usa esta variável)
PREDICTION_API_URL=http://127.0.0.1:8000/predict

# Opcional: caminho do modelo carregado pela API (padrão: modelo_pipeline_genetico.pkl)
# MODEL_PATH=modelo_pipeline_genetico.pkl

# Opcional: nível de log da API (DEBUG, INFO, WARNING)
# LOG_LEVEL=INFO
